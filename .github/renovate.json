{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver",
    ":semanticCommits"
  ],
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Automerge minor, patch and pin/digest updates of non-SciCat dependencies, once released for 3 days",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "matchPackageNames": [
        "!/scicat/i",
        "!/openem/i"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Update GitHub Actions together",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    }
  ]
}
