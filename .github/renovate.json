{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver",
    ":semanticCommits"
  ],
  "timezone": "Europe/Zurich",
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Automerge minor and patch updates of non-SciCat dependencies, once released for 3 days",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "!/scicat/i",
        "!/openem/i"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Automerge pin and digest updates of non-SciCat dependencies right away: digests have no release date to wait on",
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest"
      ],
      "matchPackageNames": [
        "!/scicat/i",
        "!/openem/i"
      ],
      "automerge": true
    },
    {
      "description": "Update GitHub Actions together",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Own images are tagged by the deploy pipeline",
      "matchPackageNames": [
        "ghcr.io/paulscherrerinstitute/scicat-ci/**"
      ],
      "enabled": false
    },
    {
      "description": "Batch automergeable helm updates into one weekly PR, so one dev + one qa deploy per week",
      "matchFileNames": [
        "helm/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "matchPackageNames": [
        "!/scicat/i",
        "!/openem/i"
      ],
      "groupName": "helm deployments",
      "schedule": [
        "* 0-5 * * 1"
      ]
    }
  ]
}
