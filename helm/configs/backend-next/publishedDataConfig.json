{
  "metadataSchema": {
    "allOf": [
      {
        "dynamicDefaults": {
          "creators": "mergeCreators",
          "publicationYear": "currentYear",
          "subjects": "mergeKeywords",
          "sizes": "computeTotalSize",
          "relatedItems": "datasetLinks"
        }
      },
      {
        "type": "object",
        "setDateAvailable": true,
        "required": [
          "creators",
          "publisher",
          "publicationYear",
          "dates",
          "language",
          "rightsList",
          "relatedItems"
        ],
        "properties": {
          "creators": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "setFullName": true,
              "properties": {
                "familyName": {
                  "type": "string",
                  "title": "Family Name",
                  "minLength": 1
                },
                "givenName": {
                  "type": "string",
                  "title": "Given Name",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "title": "Name",
                  "minLength": 1
                },
                "nameType": {
                  "type": "string",
                  "title": "Name Type",
                  "enum": [ "Personal", "Organizational" ],
                  "pattern": "Personal",
                  "default": "Personal"
                },
                "nameIdentifiers": {
                  "type": "array",
                  "title": "Name Identifiers",
                  "items": {
                    "type": "object",
                    "properties": {
                      "nameIdentifier": {
                        "type": "string",
                        "title": "ORCID",
                        "pattern": "^https://orcid.org/(\\d{4}-){3}\\d{3}(\\d|X)$"
                      },
                      "nameIdentifierScheme": {
                        "type": "string",
                        "title": "Identifier Scheme",
                        "enum": [ "ORCID" ],
                        "default": "ORCID"
                      },
                      "schemeUri": {
                        "type": "string",
                        "title": "Scheme URI",
                        "enum": [ "https://orcid.org" ],
                        "default": "https://orcid.org"
                      }
                    },
                    "required": [
                      "nameIdentifier",
                      "nameIdentifierScheme",
                      "schemeUri"
                    ]
                  }
                },
                "affiliation": {
                  "type": "array",
                  "title": "Affiliations*",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "title": "Affiliation Name",
                        "minLength": 1
                      },
                      "affiliationIdentifier": {
                        "type": "string",
                        "pattern": "^https://ror.org/0[a-z|0-9]{6}[0-9]{2}$",
                        "title": "ROR URL"
                      },
                      "affiliationIdentifierScheme": {
                        "type": "string",
                        "title": "Affiliation Identifier Scheme",
                        "enum": [ "ROR" ]
                      },
                      "schemeUri": {
                        "type": "string",
                        "title": "Scheme URI",
                        "enum": [ "https://ror.org" ]
                      }
                    },
                    "required": [ "name" ],
                    "dependentRequired": {
                      "affiliationIdentifier": [
                        "affiliationIdentifierScheme",
                        "schemeUri"
                      ]
                    }
                  }
                }
              },
              "required": [
                "name",
                "givenName",
                "familyName",
                "affiliation"
              ]
            }
          },
          "publisher": {
            "type:": "object",
            "title": "Publisher",
            "default": { },
            "properties": {
              "name": {
                "type": "string",
                "title": "Publisher Name",
                "default": "PSI Open Data Provider"
              },
              "publisherIdentifier": {
                "type": "string",
                "title": "Publisher Identifier",
                "default": "https://www.re3data.org/repository/r3d100013504"
              },
              "publisherIdentifierScheme": {
                "type": "string",
                "title": "Publisher Identifier Scheme",
                "default": "re3data"
              },
              "schemeUri": {
                "type": "string",
                "title": "Scheme URI",
                "default": "https://re3data.org/"
              },
              "lang": {
                "type": "string",
                "title": "language",
                "default": "en"
              }
            },
            "required": [
              "name",
              "publisherIdentifier",
              "publisherIdentifierScheme",
              "schemeUri",
              "lang"
            ]
          },
          "publicationYear": {
            "type": "integer",
            "title": "Publication Year",
            "mininum": 2000,
            "maximum": 9999
          },
          "contributors": {
            "type": "array",
            "items": {
              "type": "object",
              "setFullName": true,
              "properties": {
                "familyName": {
                  "type": "string",
                  "title": "Family Name",
                  "minLength": 1
                },
                "givenName": {
                  "type": "string",
                  "title": "Given Name",
                  "minLength": 1
                },
                "contributorType": {
                  "type": "string",
                  "title": "Contributor Type",
                  "enum": [
                    "ContactPerson",
                    "DataCollector",
                    "DataCurator",
                    "DataManager",
                    "Distributor",
                    "Editor",
                    "HostingInstitution",
                    "Producer",
                    "ProjectLeader",
                    "ProjectManager",
                    "RegistrationAgency",
                    "RegistrationAuthority",
                    "RelatedPerson",
                    "Researcher",
                    "RightsHolder",
                    "Sponsor",
                    "Supervisor",
                    "Translator",
                    "WorkPackageLeader",
                    "Other"
                  ]
                },
                "name": {
                  "type": "string",
                  "title": "Contributor Name",
                  "minLength": 1
                },
                "nameType": {
                  "type": "string",
                  "title": "Name Type",
                  "enum": [ "Personal" ],
                  "default": "Personal"
                },
                "nameIdentifiers": {
                  "type": "array",
                  "title": "Name Identifiers",
                  "items": {
                    "type": "object",
                    "properties": {
                      "nameIdentifier": {
                        "type": "string",
                        "title": "ORCID",
                        "pattern": "^https://orcid.org/(\\d{4}-){3}\\d{3}(\\d|X)$"
                      },
                      "nameIdentifierScheme": {
                        "type": "string",
                        "title": "Identifier Scheme",
                        "enum": [ "ORCID" ],
                        "default": "ORCID"
                      },
                      "schemeUri": {
                        "type": "string",
                        "title": "Scheme URI",
                        "enum": [ "https://orcid.org" ],
                        "default": "https://orcid.org"
                      }
                    },
                    "required": [
                      "nameIdentifier",
                      "nameIdentifierScheme",
                      "schemeUri"
                    ]
                  }
                },
                "affiliation": {
                  "type": "array",
                  "title": "Affiliations",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "title": "Affiliation Name",
                        "minLength": 1
                      },
                      "affiliationIdentifier": {
                        "type": "string",
                        "pattern": "^https://ror.org/0[a-z|0-9]{6}[0-9]{2}$",
                        "title": "ROR URL"
                      },
                      "affiliationIdentifierScheme": {
                        "type": "string",
                        "title": "Affiliation Identifier Scheme",
                        "enum": [ "ROR" ]
                      },
                      "schemeUri": {
                        "type": "string",
                        "title": "Scheme URI",
                        "enum": [ "https://ror.org" ]
                      }
                    },
                    "required": [ "name" ],
                    "dependentRequired": {
                      "affiliationIdentifier": [
                        "affiliationIdentifierScheme",
                        "schemeUri"
                      ]
                    }
                  }
                }
              },
              "required": [
                "contributorType",
                "name",
                "givenName",
                "familyName",
                "affiliation"
              ]
            }
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [ "subject", "lang" ],
              "properties": {
                "subject": {
                  "type": "string",
                  "title": "Keyword"
                },
                "subjectScheme": {
                  "type": "string",
                  "title": "Subject Scheme"
                },
                "schemeUri": {
                  "type": "string",
                  "title": "Subject URI"
                },
                "valueUri": {
                  "type": "string",
                  "title": "Value URI"
                },
                "lang": {
                  "type": "string",
                  "title": "Language",
                  "enum": [ "en" ],
                  "default": "en"
                },
                "classificationCode": {
                  "type": "string",
                  "title": "Classification Code"
                }
              }
            }
          },
          "dates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "date",
                "dateType"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}$",
                  "title": "Date"
                },
                "dateType": {
                  "type": "string",
                  "title": "Date Type",
                  "enum": [
                    "Accepted",
                    "Available",
                    "Copyrighted",
                    "Collected",
                    "Coverage",
                    "Created",
                    "Issued",
                    "Submitted",
                    "Updated",
                    "Valid",
                    "Withdrawn",
                    "Other"
                  ]
                },
                "dateInformation": {
                  "type": "string",
                  "title": "Date Information"
                }
              }
            }
          },
          "language": {
            "type": "string",
            "title": "Language",
            "enum": [ "en" ],
            "default": "en"
          },
          "types": {
            "type": "object",
            "title": "Resource Type",
            "properties": {
              "resourceType": {
                "type": "string"
              },
              "resourceTypeGeneral": {
                "type": "string",
                "enum": [ "Dataset" ]
              }
            }
          },
          "alternateIdentifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "alternateIdentifier": {
                  "type": "string",
                  "title": "Alternate Identifier"
                },
                "alternateIdentifierType": {
                  "type": "string",
                  "title": "Alternate Identifier Type"
                }
              },
              "required": [ "alternateIdentifier", "alternateIdentifierType" ]
            }
          },
          "relatedIdentifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "relatedIdentifier": {
                  "type": "string",
                  "title": "Related Identifier",
                  "pattern": "^10\\.\\d{4,9}/[-._;()/:a-zA-Z0-9]+$"
                },
                "relatedIdentifierType": {
                  "type": "string",
                  "title": "Related Identifier Type",
                  "default": "DOI",
                  "enum": [ "DOI" ]
                },
                "relationType": {
                  "type": "string",
                  "title": "Relation Type",
                  "default": "IsSupplementTo",
                  "enum": [ "IsSupplementTo", "IsIdenticalTo" ]
                },
                "relatedMetadataScheme": {
                  "type": "string",
                  "title": "Related Metadata Scheme"
                },
                "schemeUri": {
                  "type": "string",
                  "title": "Scheme URI"
                },
                "schemeType": {
                  "type": "string",
                  "title": "Scheme Type",
                  "enum": [ "DOI", "Handle", "URL", "Other" ]
                },
                "resourceTypeGeneral": {
                  "type": "string",
                  "title": "Resource Type",
                  "default": "JournalArticle",
                  "enum": [ "JournalArticle" ]
                }
              },
              "required": [
                "relatedIdentifier",
                "relatedIdentifierType",
                "relationType",
                "resourceTypeGeneral"
              ]
            }
          },
          "sizes": {
            "type": "array",
            "items": {
              "type": "string",
              "title": "Total size in bytes"
            }
          },
          "formats": {
            "type": "array",
            "items": {
              "type": "string",
              "title": "Format"
            }
          },
          "rightsList": {
            "title": "Rights",
            "type": "array",
            "minItems": 1,
            "default": [ { } ],
            "items": {
              "type": "object",
              "required": [
                "rights",
                "rightsUri",
                "rightsIdentifier",
                "rightsIdentifierScheme",
                "schemeUri",
                "lang"
              ],
              "properties": {
                "rights": {
                  "type": "string",
                  "title": "Rights",
                  "default": "Creative Commons Attribution Share Alike 4.0 International"
                },
                "rightsUri": {
                  "type": "string",
                  "title": "Rights URI",
                  "default": "https://creativecommons.org/licenses/by-sa/4.0/"
                },
                "rightsIdentifier": {
                  "type": "string",
                  "title": "Rights Identifier",
                  "default": "CC-BY-SA-4.0"
                },
                "rightsIdentifierScheme": {
                  "type": "string",
                  "title": "Rights Identifier Scheme",
                  "default": "SPDX"
                },
                "schemeUri": {
                  "type": "string",
                  "title": "Scheme URI",
                  "default": "https://spdx.org/licenses/"
                },
                "lang": {
                  "type": "string",
                  "title": "language",
                  "default": "en"
                }
              }
            }
          },
          "descriptions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string",
                  "title": "Description"
                },
                "descriptionType": {
                  "type": "string",
                  "title": "Description Type",
                  "enum": [
                    "Methods",
                    "SeriesInformation",
                    "TableOfContents",
                    "TechnicalInfo",
                    "Other"
                  ]
                },
                "lang": {
                  "type": "string",
                  "title": "Language",
                  "default": "en"
                }
              },
              "required": [ "description", "descriptionType" ]
            }
          },
          "geoLocations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "geoLocationPlace": {
                  "type": "string",
                  "title": "Geolocation Place"
                },
                "geoLocationPoint": {
                  "type": "object",
                  "properties": {
                    "pointLongitude": {
                      "type": "number",
                      "title": "Longitude",
                      "minimum": -180,
                      "maximum": 180
                    },
                    "pointLatitude": {
                      "type": "number",
                      "title": "Latitude",
                      "minimum": -90,
                      "maximum": 90
                    }
                  },
                  "required": [ "pointLongitude", "pointLatitude" ]
                },
                "geoLocationBox": {
                  "type": "object",
                  "properties": {
                    "westBoundLongitude": {
                      "type": "number",
                      "title": "West Bound Longitude",
                      "minimum": -180,
                      "maximum": 180
                    },
                    "eastBoundLongitude": {
                      "type": "number",
                      "title": "East Bound Longitude",
                      "minimum": -180,
                      "maximum": 180
                    },
                    "southBoundLatitude": {
                      "type": "number",
                      "title": "South Bound Latitude",
                      "minimum": -90,
                      "maximum": 90
                    },
                    "northBoundLatitude": {
                      "type": "number",
                      "title": "North Bound Latitude",
                      "minimum": -90,
                      "maximum": 90
                    }
                  },
                  "required": [
                    "westBoundLongitude",
                    "eastBoundLongitude",
                    "southBoundLatitude",
                    "northBoundLatitude"
                  ]
                }
              }
            }
          },
          "fundingReferences": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "funderName": {
                  "type": "string",
                  "title": "Funder Name"
                },
                "funderIdentifier": {
                  "type": "string",
                  "title": "Funder Identifier"
                },
                "funderIdentifierType": {
                  "type": "string",
                  "title": "Funder Identifier Type",
                  "enum": [ "ROR", "GRID", "Crossref Funder ID", "ISNI", "Other" ]
                },
                "awardTitle": {
                  "type": "string",
                  "title": "Award Title"
                },
                "awardNumber": {
                  "type": "string",
                  "title": "Award Number"
                },
                "awardUri": {
                  "type": "string",
                  "title": "Award URI"
                }
              },
              "required": [ "funderName", "funderIdentifierType" ]
            }
          },
          "relatedItems": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "relatedItemType": {
                  "type": "string",
                  "title": "Related Item Type",
                  "enum": [
                    "Audiovisual",
                    "Award",
                    "Book",
                    "BookChapter",
                    "Collection",
                    "ComputationalNotebook",
                    "ConferencePaper",
                    "ConferenceProceeding",
                    "DataPaper",
                    "Dataset",
                    "Dissertation",
                    "Event",
                    "Image",
                    "InteractiveResource",
                    "Instrument",
                    "Journal",
                    "JournalArticle",
                    "Model",
                    "OutputManagementPlan",
                    "PeerReview",
                    "PhysicalObject",
                    "Preprint",
                    "Project",
                    "Report",
                    "Service",
                    "Software",
                    "Sound",
                    "Standard",
                    "StudyRegistration",
                    "Text",
                    "Workflow",
                    "Other"
                  ]
                },
                "relationType": {
                  "type": "string",
                  "title": "Relation Type",
                  "enum": [
                    "IsCitedBy",
                    "Cites",
                    "IsSupplementTo",
                    "IsSupplementedBy",
                    "IsContinuedBy",
                    "Continues",
                    "IsDescribedBy",
                    "Describes",
                    "HasMetadata",
                    "IsMetadataFor",
                    "HasVersion",
                    "IsVersionOf",
                    "IsNewVersionOf",
                    "IsPreviousVersionOf",
                    "IsPartOf",
                    "HasPart",
                    "IsPublishedIn",
                    "IsReferencedBy",
                    "References",
                    "IsDocumentedBy",
                    "Documents",
                    "IsCompiledBy",
                    "Compiles",
                    "IsVariantFormOf",
                    "IsOriginalFormOf",
                    "IsIdenticalTo",
                    "IsReviewedBy",
                    "Reviews",
                    "IsDerivedFrom",
                    "IsSourceOf",
                    "IsRequiredBy",
                    "Requires",
                    "IsObsoletedBy",
                    "Obsoletes",
                    "IsCollectedBy",
                    "Collects",
                    "IsTranslationOf",
                    "HasTranslation"
                  ]
                },
                "relatedItemIdentifier": {
                  "type": "object",
                  "properties": {
                    "relatedItemIdentifier": {
                      "type": "string",
                      "title": "Related Item Identifier"
                    },
                    "relatedItemIdentifierType": {
                      "type": "string",
                      "title": "Related Item Identifier Type",
                      "enum": [
                        "ARK",
                        "DOI",
                        "Handle",
                        "ISBN",
                        "ISSN",
                        "ISTC",
                        "LSID",
                        "PURL",
                        "URL",
                        "arXiv",
                        "bibcode",
                        "CSTR",
                        "EAN13",
                        "EISSN",
                        "PMID",
                        "UPC",
                        "URN",
                        "w3id",
                        "RRID",
                        "LISSN",
                        "IGSN"
                      ]
                    },
                    "relatedMetadataScheme": {
                      "type": "string",
                      "title": "Related Metadata Scheme"
                    },
                    "schemeUri": {
                      "type": "string",
                      "title": "Scheme URI"
                    },
                    "schemeType": {
                      "type": "string",
                      "title": "Scheme Type"
                    }
                  }
                },
                "creators": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "title": "Creator Name"
                      },
                      "nameType": {
                        "type": "string",
                        "title": "Name Type",
                        "enum": [ "Personal", "Organizational" ]
                      },
                      "givenName": {
                        "type": "string",
                        "title": "Given Name"
                      },
                      "familyName": {
                        "type": "string",
                        "title": "Family Name"
                      }
                    },
                    "required": [ "name" ]
                  }
                },
                "titles": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "title": "Title"
                      },
                      "titleType": {
                        "type": "string",
                        "title": "Title Type",
                        "enum": [
                          "AlternativeTitle",
                          "Subtitle",
                          "TranslatedTitle",
                          "Other"
                        ]
                      }
                    },
                    "required": [ "title" ]
                  }
                },
                "publicationYear": {
                  "type": "string",
                  "title": "Publication Year"
                },
                "volume": {
                  "type": "string",
                  "title": "Volume"
                },
                "issue": {
                  "type": "string",
                  "title": "Issue"
                },
                "number": {
                  "type": "string",
                  "title": "Number"
                },
                "numberType": {
                  "type": "string",
                  "title": "Number Type",
                  "enum": [ "Article", "Chapter", "Report", "Other" ]
                },
                "firstPage": {
                  "type": "string",
                  "title": "First Page"
                },
                "lastPage": {
                  "type": "string",
                  "title": "Last Page"
                },
                "publisher": {
                  "type": "string",
                  "title": "Publisher"
                },
                "edition": {
                  "type": "string",
                  "title": "Edition"
                },
                "contributors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "contributorType": {
                        "type": "string",
                        "title": "Contributor Type",
                        "enum": [
                          "ContactPerson",
                          "DataCollector",
                          "DataCurator",
                          "DataManager",
                          "Distributor",
                          "Editor",
                          "HostingInstitution",
                          "Producer",
                          "ProjectLeader",
                          "ProjectManager",
                          "ProjectMember",
                          "RegistrationAgency",
                          "RegistrationAuthority",
                          "RelatedPerson",
                          "Researcher",
                          "ResearchGroup",
                          "RightsHolder",
                          "Sponsor",
                          "Supervisor",
                          "Translator",
                          "WorkPackageLeader",
                          "Other"
                        ]
                      },
                      "name": {
                        "type": "string",
                        "title": "Contributor Name"
                      },
                      "nameType": {
                        "type": "string",
                        "title": "Name Type",
                        "enum": [ "Personal", "Organizational" ]
                      },
                      "givenName": {
                        "type": "string",
                        "title": "Given Name"
                      },
                      "familyName": {
                        "type": "string",
                        "title": "Family Name"
                      }
                    },
                    "required": [ "name", "contributorType" ]
                  }
                }
              },
              "required": [
                "relatedItemType",
                "relationType",
                "relatedItemIdentifier"
              ]
            }
          }
        }
      }
    ]
  },

  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Label",
        "text": "Need help filling in this form? See the publishing guide at https://data-catalog-services.pages.psi.ch/ingestorManual/#publish"
      },
      {
        "type": "Categorization",
        "options": {
          "variant": "stepper",
          "showNavButtons": true
        },
        "elements": [
          {
            "type": "Category",
            "label": "Creators*",
            "elements": [
              {
                "type": "ListWithDetail",
                "scope": "#/properties/creators",
                "options": {
                  "detail": {
                    "type": "VerticalLayout",
                    "elements": [
                      {
                        "type": "VerticalLayout",
                        "elements": [
                          {
                            "type": "Control",
                            "scope": "#/properties/nameType",
                            "label": "Name type"
                          },
                          {
                            "type": "HorizontalLayout",
                            "elements": [
                              {
                                "type": "Control",
                                "scope": "#/properties/givenName",
                                "label": "First Name"
                              },
                              {
                                "type": "Control",
                                "scope": "#/properties/familyName",
                                "label": "Last Name"
                              }
                            ]
                          },
                          {
                            "type": "HorizontalLayout",
                            "elements": [
                              {
                                "type": "Group",
                                "label": "Affiliations",
                                "elements": [
                                  {
                                    "type": "ListWithDetail",
                                    "scope": "#/properties/affiliation"
                                  }
                                ]
                              },
                              {
                                "type": "Group",
                                "label": "Personal Identifiers",
                                "elements": [
                                  {
                                    "type": "ListWithDetail",
                                    "scope": "#/properties/nameIdentifiers",
                                    "label": "Affiliations"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
