bases:
  - ../../helmfile-common.yaml

# Only development builds. qa and production pull the image development pushed.
# frontend and frontend-next build the same repository at two different commits, so
# each pushes to its own image package.
environments:
  development:
    values:
      - sourceRepo: https://github.com/SciCatProject/frontend
---
releases:
  - name: frontend
    namespace: scicat-{{ .Environment.Name }}
    chart: oci://ghcr.io/paulscherrerinstitute/dc-charts/generic-service
    version: 2.0.0
    {{ if .Values.sourceRepo }}
    inherit:
      - template: build
    {{ end }}
    values:
      - values.yaml
      - {{ .Environment.Name }}/values.yaml
    set:
      - name: KEYCLOAK_ICON
        file: keycloak_icon_256px.svg
      - name: ENVIRONMENT
        file: {{ .Environment.Name }}/config.json
