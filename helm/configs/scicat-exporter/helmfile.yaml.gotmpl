bases:
  - ../../helmfile-common.yaml

# source.yaml is read twice. Here the state reads it, to pick the build template.
# Below the chart reads it, to pull the image. A release values file never reaches
# the state, so both entries are needed.
environments:
  development:
    values: [source.yaml]
  qa:
    values: [source.yaml]
  production:
    values: [source.yaml]
---
releases:
  - name: scicat-exporter
    namespace: scicat-{{ .Environment.Name }}
    chart: oci://ghcr.io/paulscherrerinstitute/dc-charts/generic-service
    version: 2.0.0
    {{ if .Values.sourceRepo }}
    inherit:
      - template: build
    {{ end }}
    values:
      - values.yaml
      - source.yaml
      - {{ .Environment.Name }}/values.yaml
      # The deploy passes every secret of the environment. This release reads one.
      {{ if hasKey .Values "secrets" }}
      - secretsJson:
          EXPORTER_WHITELIST_CIDRS: {{ .Values.secrets.EXPORTER_WHITELIST_CIDRS | quote }}
      {{ end }}
