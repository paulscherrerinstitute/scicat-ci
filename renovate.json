{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "description": "Automerge minor and patch updates of non-SciCat dependencies, once released for 3 days",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "!/scicat/i",
        "!/openem/i"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Update GitHub Actions together",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    }
  ]
}
