{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Automerge minor and patch updates of non-SciCat dependencies",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "!/scicat/i",
        "!/openem/i"
      ],
      "automerge": true
    }
  ]
}
